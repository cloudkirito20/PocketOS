<UserControl x:Class="PocketOS.Manager.Controls.OLEDPreview"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Border Width="260"
        Height="140"
        Background="Black"
        Padding="10">

<StackPanel>
<TextBlock Text="{Binding PokemonName}"
Foreground="White"
FontSize="22"/>

<TextBlock Text="{Binding Level}"
Foreground="White"/>

<TextBlock Text="{Binding HP}"
Foreground="White"/>

</StackPanel>

</Border>

</UserControl>
