<UserControl x:Class="PocketOS.Manager.Views.UpdatesView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<Grid Margin="20">
    <StackPanel>

        <TextBlock Text="Updates"
                   FontSize="28"
                   FontWeight="Bold"/>

        <Border Margin="0,20,0,10">
            <StackPanel>
                <TextBlock Text="Windows Manager"/>
                <TextBlock Text="{Binding ManagerVersion}"/>
                <Button Content="Download Update"
                        Command="{Binding UpdateManagerCommand}"/>
            </StackPanel>
        </Border>


        <Border Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="Pokemon Bridge"/>
                <TextBlock Text="{Binding BridgeVersion}"/>
                <Button Content="Download Update"
                        Command="{Binding UpdateBridgeCommand}"/>
            </StackPanel>
        </Border>


        <Border Margin="0,10,0,10">
            <StackPanel>
                <TextBlock Text="ESP32 Firmware"/>
                <TextBlock Text="{Binding ESP32Version}"/>
                <TextBlock Text="{Binding ESP32DeviceStatus}"/>

                <Button Content="Flash Firmware"
                        Command="{Binding FlashESP32Command}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}"
                   Margin="0,20,0,0"/>

    </StackPanel>
</Grid>

</UserControl>
