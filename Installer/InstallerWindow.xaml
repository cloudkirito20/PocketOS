    <Window x:Class="LazyTech.PocketOS.Installer.InstallerWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="LazyTech PocketOS Installer"
            Width="760"
            Height="560"
            WindowStartupLocation="CenterScreen"
            ResizeMode="NoResize"
            Background="#081008"
            Foreground="#D8F0D0"
            FontFamily="Consolas">

        <Window.Resources>
            <SolidColorBrush x:Key="RetroBg" Color="#081008"/>
            <SolidColorBrush x:Key="RetroPanel" Color="#0D160D"/>
            <SolidColorBrush x:Key="RetroAccent" Color="#D8F0D0"/>
            <SolidColorBrush x:Key="RetroBorder" Color="#A8C8A0"/>
            <SolidColorBrush x:Key="RetroButton" Color="#102010"/>
            <SolidColorBrush x:Key="RetroButtonHover" Color="#183018"/>
            <SolidColorBrush x:Key="RetroButtonPressed" Color="#244024"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource RetroAccent}" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource RetroAccent}" />
                <Setter Property="Background" Value="#020702" />
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="CaretBrush" Value="{StaticResource RetroAccent}" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource RetroAccent}" />
                <Setter Property="Background" Value="{StaticResource RetroButton}" />
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RetroButtonHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RetroButtonPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource RetroAccent}" />
                <Setter Property="Background" Value="#030903" />
                <Setter Property="BorderBrush" Value="{StaticResource RetroBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="20" />
            </Style>
        </Window.Resources>

        <Border Margin="14"
                BorderBrush="{StaticResource RetroBorder}"
                BorderThickness="2"
                Background="{StaticResource RetroBg}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource RetroPanel}"
                        BorderBrush="{StaticResource RetroBorder}"
                        BorderThickness="2"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="LT &gt; POCKETOS // INSTALLER"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="MONOCHROME RETRO ONLINE INSTALLER"
                                   Margin="0,8,0,0"
                                   FontSize="14" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource RetroPanel}"
                        BorderBrush="{StaticResource RetroBorder}"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="INSTALL LOCATION"
                                   FontSize="14"
                                   FontWeight="Bold" />
                        <TextBox x:Name="InstallPathTextBox"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Background="{StaticResource RetroPanel}"
                        BorderBrush="{StaticResource RetroBorder}"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="STATUS"
                                   FontSize="14"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Margin="0,8,0,0"
                                   Text="READY. PRESS INSTALL TO DOWNLOAD AND DEPLOY POCKETOS." />
                        <TextBlock x:Name="LoadingTextBlock"
                                   Margin="0,8,0,0"
                                   FontWeight="Bold"
                                   Visibility="Collapsed"
                                   Text="[          ] INSTALLING" />
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="InstallProgressBar"
                             Grid.Row="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"
                             IsIndeterminate="False" />

                <Border Grid.Row="8"
                        Background="{StaticResource RetroPanel}"
                        BorderBrush="{StaticResource RetroBorder}"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="INSTALL LOG"
                                   FontSize="14"
                                   FontWeight="Bold" />

                        <TextBox x:Name="LogTextBox"
                                 Grid.Row="2"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                </Border>

                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="INSTALLER DOWNLOADS MANAGER, BRIDGE, UPDATER, AND FIRMWARE INTO ONE FOLDER." />

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Width="110"
                            Content="EXIT"
                            Click="CloseButton_Click" />

                    <Button x:Name="InstallButton"
                            Grid.Column="3"
                            Width="160"
                            Content="INSTALL"
                            Click="InstallButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Window>
